{
  "name": "EXAM AI — Slack file archive (Slack → Google Drive → EXAM AI index)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "exam-ai-file-archive",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        }
      },
      "name": "EXAM AI archive job",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "exam-ai-file-archive"
    },
    {
      "parameters": {
        "jsCode": "// EXAM AI가 FILE_ARCHIVE_SECRET으로 서명한 작업만 처리한다(서명: v1=HMAC-SHA256(`${ts}.${rawBody}`)).\n// 필요: NODE_FUNCTION_ALLOW_BUILTIN=crypto, FILE_ARCHIVE_SECRET(n8n 환경변수), N8N_BLOCK_ENV_ACCESS_IN_NODE=false\nconst crypto = require('crypto');\nconst secret = $env.FILE_ARCHIVE_SECRET;\nif (!secret) throw new Error('FILE_ARCHIVE_SECRET not configured');\nconst out = [];\nfor (const item of $input.all()) {\n  const headers = item.json.headers || {};\n  const ts = String(headers['x-exam-ai-timestamp'] || '');\n  const sig = String(headers['x-exam-ai-signature'] || '');\n  const raw = item.binary && item.binary.data ? Buffer.from(item.binary.data.data, 'base64').toString('utf8') : JSON.stringify(item.json.body);\n  const expected = 'v1=' + crypto.createHmac('sha256', secret).update(`${ts}.${raw}`).digest('hex');\n  if (!/^\\d+$/.test(ts) || Math.abs(Date.now() / 1000 - Number(ts)) > 300) throw new Error('stale or missing timestamp');\n  if (sig.length !== expected.length || !crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(expected))) throw new Error('bad signature');\n  const job = JSON.parse(raw);\n  if (job.version !== 1 || !Array.isArray(job.files)) throw new Error('unsupported job');\n  const rootByBranch = { sajik: $env.DRIVE_ARCHIVE_FOLDER_SAJIK, geumjeong: $env.DRIVE_ARCHIVE_FOLDER_GEUMJEONG };\n  const rootFolderId = rootByBranch[job.branchCode];\n  if (!rootFolderId) throw new Error(`no Drive archive folder for branch ${job.branchCode}`);\n  for (const f of job.files) {\n    const search = `?teamId=${encodeURIComponent(job.teamId)}&fileId=${encodeURIComponent(f.id)}`;\n    const lookupTs = String(Math.floor(Date.now() / 1000));\n    const month = (f.createdAt || new Date().toISOString()).slice(0, 7); // YYYY-MM\n    out.push({ json: {\n      branchCode: job.branchCode, callbackUrl: job.callbackUrl, teamId: job.teamId, channelId: job.channelId,\n      messageTs: job.messageTs, threadTs: job.threadTs, userId: job.userId, messageText: job.messageText,\n      fileId: f.id, fileName: f.name, mimeType: f.mimeType, fileSize: f.size, uploadedAt: f.createdAt,\n      rootFolderId, monthFolderName: month,\n      lookupUrl: job.callbackUrl + search, lookupTs,\n      lookupSig: 'v1=' + crypto.createHmac('sha256', secret).update(`${lookupTs}.${search}`).digest('hex'),\n    } });\n  }\n}\nreturn out;"
      },
      "name": "Verify signature & split files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.lookupUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-exam-ai-timestamp",
              "value": "={{ $json.lookupTs }}"
            },
            {
              "name": "x-exam-ai-signature",
              "value": "={{ $json.lookupSig }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Already archived in EXAM AI?",
