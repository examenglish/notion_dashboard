    {
      "parameters": {
        "jsCode": "// EXAM AI 등록 요청 서명(v1=HMAC-SHA256(`${ts}.${body}`)) — 서명한 문자열 그대로 보낸다.\nconst crypto = require('crypto');\nconst secret = $env.FILE_ARCHIVE_SECRET;\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const body = JSON.stringify({\n    branchCode: j.branchCode, teamId: j.teamId, channelId: j.channelId, messageTs: j.messageTs, threadTs: j.threadTs,\n    fileId: j.fileId, userId: j.userId, messageText: j.messageText, originalFilename: j.fileName, mimeType: j.mimeType,\n    fileSize: j.fileSize, uploadedAt: j.uploadedAt, driveFileId: j.driveFileId, driveUrl: j.driveUrl, driveFolderId: j.driveFolderId,\n  });\n  const ts = String(Math.floor(Date.now() / 1000));\n  out.push({ json: { callbackUrl: j.callbackUrl, body, ts, sig: 'v1=' + crypto.createHmac('sha256', secret).update(`${ts}.${body}`).digest('hex') } });\n}\nreturn out;"
      },
