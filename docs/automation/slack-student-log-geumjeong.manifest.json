{
  "_metadata": { "major_version": 1, "minor_version": 1 },
  "display_information": {
    "name": "학생기록봇(금정)",
    "description": "금정 학생기록 채널 메시지를 금정 웹앱(EXAM AI) 학생기록 DB에 저장"
  },
  "features": {
    "bot_user": { "display_name": "학생기록봇", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["channels:history", "groups:history", "chat:write", "reactions:write", "users:read"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://slack.examenglishsj.co.kr/api/slack/events",
      "bot_events": ["message.channels", "message.groups"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
