# Notion internal integration secret (server-only, never exposed to the browser).
# Create at https://www.notion.so/my-integrations, then share the "학원관리" page
# (and everything under it) with that integration in Notion's Share menu.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Data source (collection) IDs for each database under 학원관리.
# Get these from the collection://<id> URL shown by Notion's "view" / API responses,
# or from the database URL after sharing it with your integration.
NOTION_DB_CLASS=88c7e533-7905-4ed9-89e8-73c1274b5898
NOTION_DB_STUDENT=dd31ca02-85ea-4d6a-9ede-a962722ff065
NOTION_DB_CLASS_PROGRESS=f3ad5933-cd57-4cc0-bbad-0bd3d2a2c882
NOTION_DB_DAILY_RECORD=00bd32ea-09ce-4e0e-9929-7fdc02763925
NOTION_DB_BRIEFING=d036bef8-958d-4472-8b41-d214d5493483
NOTION_DB_EXAM_SCORE=7d098d38-3010-4d8c-a79d-607ca6c3b4fc
NOTION_DB_EXAM_PREP=15deab6b-b3d8-4cc4-a01c-aa259ba036d3
NOTION_DB_COUNSELING=a20b4b24-3e7c-4931-9d51-31a0253285e8
NOTION_DB_ADMIN_INBOX=c173e1bc-ff7f-4d4e-89a8-3b83788f48ee
NOTION_DB_TODO=6450c9f2-9205-430c-a5de-9c88df6f525d
NOTION_DB_STAFF=642c681d-8b92-48ea-82fe-075da8ecc036

# Random long string used to sign the login session cookie (HMAC-SHA256).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Anthropic API key, used server-side only to parse free-form Korean text
# entered in the "자연어 입력" box on the dashboard into structured Notion
# writes. Get one at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Branch label shown in the top bar between the logo and the nav links.
# Each branch's Vercel project should set its own value, e.g.
# "사직이그잼영어학원" or "금정 이그잼영어학원".
NEXT_PUBLIC_BRANCH_NAME=이그잼영어학원

# Authenticates Vercel Cron's call to /api/cron/* (that route has no login
# session, so it checks this bearer token instead). Generate with:
# openssl rand -hex 24. See vercel.json for the cron schedule.
CRON_SECRET=replace-with-a-long-random-string
